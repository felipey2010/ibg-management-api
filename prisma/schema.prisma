generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model announcement_destinations {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcement_id String                @db.Uuid
  type            announcement_audience
  ministry_id     String?               @db.Uuid
  created_at      DateTime              @default(now()) @db.Timestamptz(6)
  announcements   announcements         @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ministries      ministries?           @relation(fields: [ministry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([announcement_id], map: "idx_announcement_destinations_announcement_id")
  @@index([ministry_id], map: "idx_announcement_destinations_ministry_id")
  @@schema("public")
}

model announcement_images {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcement_id String        @db.Uuid
  file_id         String        @db.Uuid
  display_order   Int           @default(0)
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  files           files         @relation(fields: [file_id], references: [id], onUpdate: NoAction)

  @@unique([announcement_id, file_id], map: "uq_announcement_images_announcement_file")
  @@index([announcement_id], map: "idx_announcement_images_announcement_id")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model announcements {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                     String
  content                   String
  status                    announcement_status         @default(DRAFT)
  published_at              DateTime?                   @db.Timestamptz(6)
  starts_at                 DateTime?                   @db.Timestamptz(6)
  ends_at                   DateTime?                   @db.Timestamptz(6)
  created_by_id             String?                     @db.Uuid
  event_id                  String?                     @db.Uuid
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  archived_at               DateTime?                   @db.Timestamptz(6)
  announcement_destinations announcement_destinations[]
  announcement_images       announcement_images[]
  users                     users?                      @relation(fields: [created_by_id], references: [id], onUpdate: NoAction)
  events                    events?                     @relation(fields: [event_id], references: [id], onUpdate: NoAction)

  @@index([event_id], map: "idx_announcements_event_id")
  @@index([starts_at, ends_at], map: "idx_announcements_starts_ends")
  @@index([status, published_at], map: "idx_announcements_status_published")
  @@schema("public")
}

