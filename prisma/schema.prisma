model notifications {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  type          String
  title         String
  message       String
  resource_type String?
  resource_id   String?   @db.Uuid
  read_at       DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([resource_type, resource_id], map: "idx_notifications_resource")
  @@index([user_id, read_at], map: "idx_notifications_user_read")
  @@schema("public")
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique(map: "uq_permissions_code")
  description      String?
  role_permissions role_permissions[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model required_contribution_items {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id            String                 @db.Uuid
  name                   String
  description            String?
  required_quantity      Decimal                @db.Decimal(12, 2)
  maximum_contributors   Int?
  unit                   String
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  item_commitments       item_commitments[]
  contribution_campaigns contribution_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([campaign_id], map: "idx_required_contribution_items_campaign_id")
  @@schema("public")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@index([permission_id], map: "idx_role_permissions_permission_id")
  @@schema("public")
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  code             String             @unique(map: "uq_roles_code")
  description      String?
  is_system_role   Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  document_access  document_access[]
  role_permissions role_permissions[]
  user_roles       user_roles[]

  @@schema("public")
}

model storage_locations {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  is_active       Boolean           @default(true)
  inventory_items inventory_items[]

  @@schema("public")
}

model user_roles {
  user_id                                String   @db.Uuid
  role_id                                String   @db.Uuid
  assigned_at                            DateTime @default(now()) @db.Timestamptz(6)
  assigned_by_id                         String?  @db.Uuid
  users_user_roles_assigned_by_idTousers users?   @relation("user_roles_assigned_by_idTousers", fields: [assigned_by_id], references: [id], onUpdate: NoAction)
  roles                                  roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_roles_user_idTousers        users    @relation("user_roles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
  @@index([role_id], map: "idx_user_roles_role_id")
  @@schema("public")
}

model user_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  ip_address         String?
  user_agent         String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_user_sessions_expires_at")
  @@index([user_id], map: "idx_user_sessions_user_id")
  @@schema("public")
}

model users {
  id                                                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                   String                    @unique(map: "uq_users_email")
  password_hash                                           String?
  display_name                                            String
  status                                                  user_status               @default(PENDING_APPROVAL)
  email_verified_at                                       DateTime?                 @db.Timestamptz(6)
  approved_at                                             DateTime?                 @db.Timestamptz(6)
  approved_by_id                                          String?                   @db.Uuid
  last_login_at                                           DateTime?                 @db.Timestamptz(6)
  created_at                                              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                              DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_at                                              DateTime?                 @db.Timestamptz(6)
  announcements                                           announcements[]
  audit_logs                                              audit_logs[]
  auth_accounts                                           auth_accounts[]
  bible_studies                                           bible_studies[]
  bible_study_attendance                                  bible_study_attendance[]
  contribution_campaigns                                  contribution_campaigns[]
  documents                                               documents[]
  events                                                  events[]
  files                                                   files[]
  financial_contributions                                 financial_contributions[]
  inventory_movements                                     inventory_movements[]
  item_commitments_item_commitments_approved_by_idTousers item_commitments[]        @relation("item_commitments_approved_by_idTousers")
  item_commitments_item_commitments_canceled_by_idTousers item_commitments[]        @relation("item_commitments_canceled_by_idTousers")
  member_status_history                                   member_status_history[]
  members                                                 members?
  ministries                                              ministries[]
  notifications                                           notifications[]
  user_roles_user_roles_assigned_by_idTousers             user_roles[]              @relation("user_roles_assigned_by_idTousers")
  user_roles_user_roles_user_idTousers                    user_roles[]              @relation("user_roles_user_idTousers")
  user_sessions                                           user_sessions[]
  users                                                   users?                    @relation("usersTousers", fields: [approved_by_id], references: [id], onUpdate: NoAction)
  other_users                                             users[]                   @relation("usersTousers")

  @@index([status], map: "idx_users_status")
  @@schema("public")
}

model visitors {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name      String
  email          String?
  phone          String?
  first_visit_at DateTime       @default(now()) @db.Timestamptz(6)
  status         visitor_status @default(ACTIVE)
  notes          String?
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)

  @@index([status], map: "idx_visitors_status")
  @@schema("public")
}

